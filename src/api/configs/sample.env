# Azure OpenAI Configuration (Legacy - for fallback only)
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_ENDPOINT=<your-ai-foundry-endpoint>
AZURE_OPENAI_API_KEY=# Set this to your AI Foundry key or use managed identity
AZURE_MLLM_DEPLOYMENT_MODEL=<your-mllm-deployment-name>

# Azure AI Foundry Configuration (Preferred)
AZURE_AI_FOUNDRY_ENDPOINT=<your-ai-foundry-endpoint>
AZURE_AI_FOUNDRY_PROJECT_NAME=<your-ai-foundry-project-name>
AZURE_AI_FOUNDRY_DEPLOYMENT_NAME=<your-primary-deployment-name>
AZURE_AI_FOUNDRY_API_VERSION=2024-05-01-preview

# Azure Cognitive Search Configuration
AZURE_SEARCH_ENDPOINT=<your-search-service-endpoint>
AZURE_SEARCH_API_KEY=# Set this to your search service admin key or use managed identity

# Azure Cosmos DB Configuration
AZURE_COSMOS_DB_URI=<your-cosmos-db-endpoint>
AZURE_COSMOS_DB_KEY=# Set this to your Cosmos DB key or use managed identity
AZURE_COSMOS_DB_DATABASE=<your-cosmos-database-name>
AZURE_COSMOS_DB_CONTAINER=<your-cosmos-container-name>
AZURE_COSMOS_DB_ENRICHMENT_CONTAINER=<your-enrichment-container-name>

# Azure Managed Identity Configuration (for production deployment)
AZURE_CLIENT_ID=<your-managed-identity-client-id>

# Azure Computer Vision Configuration
AZURE_COMPUTER_VISION_ENDPOINT=<your-computer-vision-endpoint>
AZURE_COMPUTER_VISION_KEY=# Set this to your Computer Vision key or use managed identity
