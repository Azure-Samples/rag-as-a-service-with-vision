# Azure OpenAI Configuration (uses managed identity authentication)
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_ENDPOINT=<your-azure-openai-endpoint>
AZURE_MLLM_DEPLOYMENT_MODEL=<your-mllm-deployment-name>

# Azure Cognitive Search Configuration (uses managed identity authentication)
AZURE_SEARCH_ENDPOINT=<your-search-service-endpoint>

# Azure Cosmos DB Configuration (uses managed identity authentication)
AZURE_COSMOS_DB_URI=<your-cosmos-db-endpoint>
AZURE_COSMOS_DB_DATABASE=<your-cosmos-database-name>
AZURE_COSMOS_DB_CONTAINER=<your-cosmos-container-name>
AZURE_COSMOS_DB_ENRICHMENT_CONTAINER=<your-enrichment-container-name>

# Azure Managed Identity Configuration (required for authentication)
AZURE_CLIENT_ID=<your-managed-identity-client-id>

# Azure Computer Vision Configuration (uses managed identity authentication)
AZURE_COMPUTER_VISION_ENDPOINT=<your-computer-vision-endpoint>
