{
    "id": "sample",
    "name": "Sample RAG Config",
    "loader_config": {
        "loader_name": "TextLoader",
        "loader_kwargs": {}
    },
    "splitter_config": {
        "splitter_name": "RecursiveCharacterTextSplitter",
        "splitter_kwargs": {
            "chunk_size": 1000,
            "chunk_overlap": 200
        }
    },
    "embedding_config": {
        "embedding_model_name": "AzureOpenAIEmbeddings",
        "embedding_model_kwargs": {
            "azure_deployment": "text-embedding-3-large",
            "openai_api_version": "2025-03-01-preview"
        }
    },
    "llm_config": {
        "llm_name": "AzureOpenAI",
        "llm_kwargs": {
            "api_version": "2023-12-01-preview",
            "deployment_name": "gpt-35-turbo"
        }
    },
    "media_enrichment": {
        "features": {
            "mllm": {
                "enabled": true,
                "prompt": "You are an assistant whose job is provide detailed text descriptions of images which are going to be used to retrieve the images.",
                "llm_kwargs": {},
                "model": "gpt-4o",
                "detail_mode": "auto"
            },
            "classifier": {
                "enabled": true,
                "threshold": 0.8
            },
            "cache": {
                "enabled": true,
                "expiry": null,
                "key_format": "2024-07-22-{hash}"
            }
        },
        "images": []
    }
}